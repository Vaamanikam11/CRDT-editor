{
  "name": "crdt-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run lint --workspaces",
    "typecheck": "npm run build --workspace shared && npm run typecheck --workspace client && npm run typecheck --workspace server",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/node": "^22.15.3",
    "eslint": "^9.25.0",
    "prettier": "^3.5.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vitest": "^3.1.2"
  },
  "engines": {
    "node": ">=18.20.0"
  }
}
